# Copy this file to .env.local and fill in the values.

# Safe in the browser. Vapi dashboard > API Keys > Public key.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Safe in the browser. Vapi dashboard > Assistants > WOW Concierge > copy ID.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# SERVER ONLY (never prefix with NEXT_PUBLIC_). Vapi dashboard > API Keys > Private key.
# Used to read the finished call if the backend is not running.
VAPI_PRIVATE_KEY=

# SERVER ONLY. Where the FastAPI backend runs, and the LEADS_API_KEY from backend/.env.
# When both are set, every finished call is saved to Supabase automatically.
BACKEND_URL=http://localhost:8000
LEADS_API_KEY=
