# Copy to .env and fill in. Never commit .env.

# Shared secret Vapi sends with every webhook (you choose this value).
# Set the same value on the assistant's Server URL credential in Vapi.
VAPI_WEBHOOK_SECRET=

# Supabase project URL and the SERVICE ROLE key (server only, bypasses row level security).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Key your own apps send in the X-API-Key header to read leads (you choose this value).
LEADS_API_KEY=

# Vapi private key. Used to pull finished calls from Vapi and save them.
VAPI_PRIVATE_KEY=

# The WOW Concierge assistant ID. Only calls from this assistant are stored.
VAPI_ASSISTANT_ID=
